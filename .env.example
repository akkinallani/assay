DATABASE_URL=postgresql://quorum:quorum@localhost:5432/quorum
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
PORT=3000
NODE_ENV=development

# Signs the session cookie. Generate with: openssl rand -base64 32
COOKIE_SECRET=dev-only-insecure-secret

# Browser-facing origins the API needs to know about (not just CORS — used to build the
# OAuth redirect URI and to redirect back to the frontend after Google sign-in completes).
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Google OAuth (Sign in with Google) — from console.cloud.google.com. Leave blank to disable;
# the API skips registering the Google routes if either is missing. Authorized redirect URI to
# add in Google Cloud Console: {API_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
