# Copy to .env.production and fill in real values before running
# `docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build`.
# Never commit the filled-in file.

# Origin(s) the web app is served from, comma-separated. Must match exactly
# (scheme + host + port) or the API will reject the browser's requests.
CORS_ORIGIN=https://your-domain.example.com

# Signs the session cookie. Generate with: openssl rand -base64 32
COOKIE_SECRET=

# Browser-facing API/web origins — used to build the Google OAuth redirect URI and to redirect
# back to the frontend after sign-in completes. Must be the real public URLs, not localhost.
API_ORIGIN=https://api.your-domain.example.com
WEB_ORIGIN=https://your-domain.example.com

# Google OAuth (Sign in with Google) — from console.cloud.google.com. Leave blank to disable.
# Authorized redirect URI to register there: {API_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used by the LLM-backed consistency checks / regrade worker.
ANTHROPIC_API_KEY=

# postgres/redis credentials and URLs are wired directly in docker-compose.prod.yml
# for the bundled containers. Point DATABASE_URL/REDIS_URL elsewhere instead if
# you're using managed/external Postgres or Redis rather than the bundled ones.
